      <bpmndi:BPMNShape id="GW_Identidad_di" bpmnElement="GW_Identidad">
        <dc:Bounds x="765.0" y="390.0" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DocAdicional_di" bpmnElement="Task_DocAdicional">
        <dc:Bounds x="920.0" y="80.0" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScreeningAlta_di" bpmnElement="Task_ScreeningAlta">
        <dc:Bounds x="920.0" y="380.0" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Coincidencia_di" bpmnElement="GW_Coincidencia">
        <dc:Bounds x="1145.0" y="390.0" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Bloquear_di" bpmnElement="Task_Bloquear">
        <dc:Bounds x="1300.0" y="530.0" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_AltaRechazada_di" bpmnElement="End_AltaRechazada">
        <dc:Bounds x="1532.0" y="547.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EvaluarRiesgo_di" bpmnElement="Task_EvaluarRiesgo">
        <dc:Bounds x="1300.0" y="380.0" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_RequiereEDD_di" bpmnElement="GW_RequiereEDD">
        <dc:Bounds x="1525.0" y="390.0" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SolicitarEvidencia_di" bpmnElement="Task_SolicitarEvidencia">
        <dc:Bounds x="1680.0" y="80.0" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AprobarCliente_di" bpmnElement="Task_AprobarCliente">
        <dc:Bounds x="1680.0" y="530.0" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RevisarEDD_di" bpmnElement="Task_RevisarEDD">
        <dc:Bounds x="1870.0" y="530.0" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CrearCliente_di" bpmnElement="Task_CrearCliente">
        <dc:Bounds x="2060.0" y="680.0" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotificarAlta_di" bpmnElement="Task_NotificarAlta">
        <dc:Bounds x="2250.0" y="80.0" width="120" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ClienteActivo_di" bpmnElement="End_ClienteActivo">
        <dc:Bounds x="2482.0" y="97.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_Onb_01_di" bpmnElement="F_Onb_01">
