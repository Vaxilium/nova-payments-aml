        <di:waypoint x="1075.0" y="415.0" />
        <di:waypoint x="1110.0" y="415.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Alr_07_di" bpmnElement="F_Alr_07">
        <di:waypoint x="1230.0" y="415.0" />
        <di:waypoint x="1265.0" y="415.0" />
        <di:waypoint x="1265.0" y="265.0" />
        <di:waypoint x="1300.0" y="265.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Alr_08_di" bpmnElement="F_Alr_08">
        <di:waypoint x="1420.0" y="265.0" />
        <di:waypoint x="1472.5" y="265.0" />
        <di:waypoint x="1472.5" y="265.0" />
        <di:waypoint x="1525.0" y="265.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Alr_09_di" bpmnElement="F_Alr_09">
        <di:waypoint x="1575.0" y="265.0" />
        <di:waypoint x="1627.5" y="265.0" />
        <di:waypoint x="1627.5" y="265.0" />
        <di:waypoint x="1680.0" y="265.0" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1619.5" y="251.0" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
